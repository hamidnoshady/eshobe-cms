# Generated — do not edit by hand.
#
# Rewritten by the CMS itself (src/deploy/routing.ts, when THEME_ROUTES_FILE is set)
# or by `node scripts/render-theme-routes.mjs` from `GET /api/platform/routing` —
# one entry per active site whose theme deployment is `live` in `edge` mode on its
# verified domain, plus that site's *verified* aliases.
#
# `map` runs early in Caddy's directive order, so `{theme_upstream}` is set before
# the `@themed` matcher in the Caddyfile reads it. The `default ""` row is what lets
# every site with no deployed theme fall through to `reverse_proxy web:3000` — and
# it is why this file is committed with no routes in it rather than not committed at
# all: a missing import is a Caddy that will not start.
#
# Example of a generated row:
#
#   acme.ir              https://bazaar-acme.sites.example.com
#   www.acme.ir          https://bazaar-acme.sites.example.com
#
map {host} {theme_upstream} {
	default ""
}
