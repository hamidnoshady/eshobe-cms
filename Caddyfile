{
    email {$ACME_EMAIL}
    # Caddy calls the ask endpoint before issuing an on-demand certificate.
    on_demand_tls {
        ask http://web:3000/api/domain-check
    }
}

# Caddy's automatic HTTP->HTTPS redirect only covers hostnames it knows in
# advance; on-demand customer domains need an explicit port-80 handler.
http:// {
    redir https://{host}{uri} permanent
}

# The control plane keeps Payload admin and API access on its own host.
https://{$CONTROL_PLANE_HOST} {
    # The ask endpoint is Caddy-internal (reached as web:3000 over the Docker
    # network); never expose it publicly, or anyone can enumerate customer domains.
    @domain_check path /api/domain-check*
    handle @domain_check {
        respond 404
    }
    handle {
        reverse_proxy web:3000
    }
}

# Every other host is a customer site. Never expose the control plane paths
# here — but the public site itself depends on API routes: the Wave 3
# contact form posts to /api/form-submissions from the customer domain, the Wave 7
# storefront posts to /api/checkout and takes the payment gateway's callback on
# /api/checkout/callback, a headless renderer reads /api/site (WAVE-9.md),
# locally-stored uploads are served from /api/media/file/*, and (WAVE-9 §9.4) a
# headless builder's own dashboard (e.g. cafe-restaurant-pos's /dashboard/website)
# reads and writes one site's content through its API key while still sending this
# site's own domain as `Host` — see the note on @cms_content below.
https:// {
    tls {
        on_demand
    }

    @form_submissions {
        method POST
        path /api/form-submissions
    }
    handle @form_submissions {
        reverse_proxy web:3000
    }

    # Checkout has no method filter: the buyer POSTs it, the browser GETs back to it
    # from the gateway, and the gateway POSTs its callback. The site a payment belongs
    # to is resolved from this Host header, which is why it must arrive here at all.
    @checkout {
        path /api/checkout /api/checkout/*
    }
    handle @checkout {
        reverse_proxy web:3000
    }

    # A headless renderer bootstraps from this on the customer's own origin: which
    # locales the site serves, its theme tokens, its currency, its block list.
    @site_descriptor {
        method GET HEAD
        path /api/site
    }
    handle @site_descriptor {
        reverse_proxy web:3000
    }

    @media_files {
        method GET HEAD
        path /api/media/file/*
    }
    handle @media_files {
        reverse_proxy web:3000
    }

    # WAVE-9 §9.4 — the site key's own read/write surface (docs/eshobe-cms-integration.md
    # in cafe-restaurant-pos). No method filter, like @checkout above: a site key
    # reads its catalogue (GET) and writes its products and order statuses
    # (POST/PATCH/DELETE), and the real boundary is the application's access layer
    # (`src/access/siteApiKey.ts` scopes every one of these paths to the bearer
    # key's own site; `src/access/siteRead.ts` does the same for an anonymous read),
    # not this proxy — the same trust split /api/site above already makes.
    @cms_content {
        path /api/pages /api/pages/* /api/posts /api/posts/* /api/categories /api/categories/* /api/products /api/products/* /api/store /api/store/* /api/orders /api/orders/*
    }
    handle @cms_content {
        reverse_proxy web:3000
    }

    @control_plane_paths path /admin* /api*
    handle @control_plane_paths {
        respond 404
    }

    handle {
        reverse_proxy web:3000
    }
}
