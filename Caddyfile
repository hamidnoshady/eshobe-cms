{
    email {$ACME_EMAIL}
    # Caddy calls the ask endpoint before issuing an on-demand certificate.
    on_demand_tls {
        ask http://web:3000/api/domain-check
    }
}

# Caddy's automatic HTTP->HTTPS redirect only covers hostnames it knows in
# advance; on-demand customer domains need an explicit port-80 handler.
http:// {
    redir https://{host}{uri} permanent
}

# The control plane keeps Payload admin and authenticated API access on its own host.
https://{$CONTROL_PLANE_HOST} {
    # The ask endpoint is Caddy-internal (reached as web:3000 over the Docker
    # network); never expose it publicly, or anyone can enumerate customer domains.
    @domain_check path /api/domain-check*
    handle @domain_check {
        respond 404
    }

    # WAVE-9 §9.4 — close the control-plane fail-open at the edge as well as in
    # collection access. A visitor on admin.example.com has no tenant; anonymous
    # REST/GraphQL reads there used to be the one URL that could enumerate every
    # customer's public content. Authenticated admin API calls and site/platform
    # API keys are carved out first; this block only catches anonymous reads.
    @handoff path /api/handoff
    handle @handoff {
        reverse_proxy web:3000
    }

    @api_with_bearer {
        path /api*
        header Authorization *
    }
    handle @api_with_bearer {
        reverse_proxy web:3000
    }

    @api_with_session {
        path /api*
        header Cookie *payload-token*
    }
    handle @api_with_session {
        reverse_proxy web:3000
    }

    @anonymous_control_plane_graphql path /api/graphql /api/graphql-playground
    handle @anonymous_control_plane_graphql {
        respond 403
    }

    @anonymous_control_plane_api_reads {
        method GET HEAD
        path /api/site /api/pages /api/pages/* /api/posts /api/posts/* /api/products /api/products/* /api/categories /api/categories/* /api/media /api/media/* /api/theme /api/theme/* /api/header /api/header/* /api/footer /api/footer/* /api/store /api/store/* /api/search /api/search/* /api/redirects /api/redirects/* /api/forms /api/forms/* /api/payments/methods
    }
    handle @anonymous_control_plane_api_reads {
        respond 403
    }

    handle {
        reverse_proxy web:3000
    }
}

# Every other host is a customer site. Never expose the control plane paths
# here — but the public site itself depends on API routes: the Wave 3
# contact form posts to /api/form-submissions from the customer domain, the Wave 7
# storefront posts to /api/checkout and takes the payment gateway's callback on
# /api/checkout/callback, that same storefront reads the shop's enabled Iranian
# payment gateways from /api/payments/methods (WAVE-10), a headless renderer reads
# /api/site (WAVE-9.md),
# locally-stored uploads are served from /api/media/file/*, and (WAVE-9 §9.4) a
# headless builder's own dashboard (e.g. cafe-restaurant-pos's /dashboard/website)
# reads and writes one site's content through its API key while still sending this
# site's own domain as `Host` — see the note on @cms_content below.
https:// {
    tls {
        on_demand
    }

    @form_submissions {
        method POST
        path /api/form-submissions
    }
    handle @form_submissions {
        reverse_proxy web:3000
    }

    # Checkout has no method filter: the buyer POSTs it, the browser GETs back to it
    # from the gateway, and the gateway POSTs its callback. The site a payment belongs
    # to is resolved from this Host header, which is why it must arrive here at all.
    @checkout {
        path /api/checkout /api/checkout/*
    }
    handle @checkout {
        reverse_proxy web:3000
    }

    # The buyer's payment-gateway picker. GET only, and only `methods`: a storefront on
    # this domain has to be able to ask which gateways the shop takes before it can draw
    # the radio group, and the answer is as public as the shop's own prices — labels,
    # blurbs, amount windows, no row ids and no credentials.
    #
    # The rest of `/api/payments/*` is deliberately NOT carved out. `self-test` makes this
    # server call a live merchant account and is platform-admin only; `cancel` moves money
    # back and is site-staff only. Both are reached from the control plane's own origin,
    # where an admin session or a site key can authorise them, and letting a customer
    # domain route to them would put a staff-only endpoint one `curl` away from anybody
    # standing on a shop's homepage. They fall through to @control_plane_paths below and
    # get a 404, which is the same answer every other control-plane path gets here.
    @payment_methods {
        method GET HEAD
        path /api/payments/methods
    }
    handle @payment_methods {
        reverse_proxy web:3000
    }

    # A headless renderer bootstraps from this on the customer's own origin: which
    # locales the site serves, its theme tokens, its currency, its block list.
    @site_descriptor {
        method GET HEAD
        path /api/site
    }
    handle @site_descriptor {
        reverse_proxy web:3000
    }

    @media_files {
        method GET HEAD
        path /api/media/file/*
    }
    handle @media_files {
        reverse_proxy web:3000
    }

    # A site key changing its own canonical domain (docs/domains.md). PATCH only,
    # distinct from @site_descriptor's GET/HEAD above; the application's access
    # layer requires a valid site key regardless, this is only routing.
    @site_domain {
        method PATCH
        path /api/site/domain
    }
    handle @site_domain {
        reverse_proxy web:3000
    }

    # A tenant can request/list/remove aliases such as `www.example.ir` and
    # `shop.example.ir`. The application adds every new hostname as *pending*;
    # only a platform admin may verify it, which is what lets `/api/domain-check`
    # authorise Caddy's on-demand TLS. Keep all three methods together so a site
    # builder can manage aliases without exposing the general `/api/sites` API.
    @site_domains {
        method GET POST DELETE
        path /api/site/domains
    }
    handle @site_domains {
        reverse_proxy web:3000
    }

    # WAVE-9 §9.4 — the site key's own read/write surface (docs/eshobe-cms-integration.md
    # in cafe-restaurant-pos). No method filter, like @checkout above: a site key
    # reads its catalogue (GET) and writes its products and order statuses
    # (POST/PATCH/DELETE), and the real boundary is the application's access layer
    # (`src/access/siteApiKey.ts` scopes every one of these paths to the bearer
    # key's own site; `src/access/siteRead.ts` does the same for an anonymous read),
    # not this proxy — the same trust split /api/site above already makes.
    @cms_content {
        path /api/pages /api/pages/* /api/posts /api/posts/* /api/categories /api/categories/* /api/products /api/products/* /api/store /api/store/* /api/orders /api/orders/*
    }
    handle @cms_content {
        reverse_proxy web:3000
    }

    # WAVE-11 §5 Option A — Caddy stays the edge, a deployed theme is an upstream.
    #
    # When a site adopts a deployable theme in `edge` mode, its pages are rendered by
    # a theme application on the Coolify box while *this* vhost keeps holding the
    # customer's certificate. That split is the whole point: every carve-out above
    # still lands on web:3000, so /api/checkout, the contact form, /api/site and
    # locally-stored media keep working on the customer's own origin, and the theme
    # never has to implement — or be trusted with — a proxy back to the CMS.
    #
    # The map is GENERATED, never hand-written: `scripts/render-theme-routes.mjs`
    # writes it from `GET /api/platform/routing`, which emits only `live` + `edge`
    # deployments and only *verified* aliases. A hand-maintained table is one
    # forgotten line away from a customer's domain serving another customer's shop.
    # The file is committed empty-by-default so a deployment with no themes at all
    # still parses; `default ""` is what makes the matcher below fall through.
    import /etc/caddy/theme-routes.caddy

    @themed expression `{theme_upstream} != ""`
    handle @themed {
        # Over https and with the upstream's own Host: the theme app answers on its
        # preview hostname, so sending the customer's Host would hit a vhost Coolify
        # does not have. The theme learns the public origin from ESHOBE_PUBLIC_ORIGIN
        # and X-Forwarded-Host, not from this header.
        reverse_proxy https://{theme_upstream} {
            header_up Host {theme_upstream}
            header_up X-Forwarded-Host {host}
        }
    }

    # Everything else under /api on a customer domain is a 404, and two families are
    # deliberately left here rather than carved out above:
    #   - POST /api/payments/self-test and /api/payments/cancel — staff endpoints;
    #   - /api/platform/* (src/endpoints/platformControl.ts) — the operator surface the
    #     sibling POS's super-admin console drives this deployment through. It is called
    #     with the CONTROL PLANE's own Host (the POS client only forwards a site's domain
    #     on site-scoped calls), so it lands on the control-plane block and needs nothing
    #     here. Carving it out would put "list every customer, export their content" one
    #     `curl` away from anybody standing on a shop's homepage.
    @control_plane_paths path /admin* /api*
    handle @control_plane_paths {
        respond 404
    }

    handle {
        reverse_proxy web:3000
    }
}
