# Local development only — matches docker-compose.yml (host port 5433).
# Dev keeps Payload's push mode against this local database. Never point dev/push
# at production. The runtime variable is DATABASE_URL, not DATABASE_URI.
DATABASE_URL=postgres://eshobe:eshobe@127.0.0.1:5433/eshobe

# Production uses TWO roles/URLs for the SAME database (see README.md):
# DATABASE_URL: restricted eshobe_app role, passed to web only; OWNS schema public.
# MIGRATE_DATABASE_URL: owner/privileged eshobe role, passed to migrate only.
# Required for `pnpm migrate` and docker-compose.srv1.yml. There is NO fallback to
# DATABASE_URL. Set it in Komodo's deployment environment, never a build arg or
# web env_file. Leave unset in dev; do not migrate a database created with push.
# MIGRATE_DATABASE_URL=postgres://eshobe:<URL-encoded-owner-password>@db:5432/eshobe
# DATABASE_URL=postgres://eshobe_app:<URL-encoded-runtime-password>@db:5432/eshobe
#
# The migrate step also needs to know the runtime role that owns the schema
# (APP_DATABASE_ROLE). It is never hardcoded or guessed: srv1 passes it to the
# one-shot migrate service explicitly because DATABASE_URL must not reach it,
# while a bare `pnpm migrate` can simply export DATABASE_URL alongside
# MIGRATE_DATABASE_URL and have the role derived from its username.
# APP_DATABASE_ROLE=eshobe_app
#
# srv1 / Komodo also needs CONTROL_PLANE_HOST and POSTGRES_PASSWORD (existing DB
# owner password). Do not change project eshobe-cms or volumes pgdata/media_uploads.
# CONTROL_PLANE_HOST=admin.example.com
# POSTGRES_USER=eshobe
# POSTGRES_DB=eshobe
# POSTGRES_PASSWORD=
#
# SECURITY: Komodo logs expanded `docker compose config` in plaintext, including
# MIGRATE_DATABASE_URL. Restrict deploy-log access and include this privileged
# credential in the rotation list alongside the credentials already exposed.

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# WAVE-9 §9.4 — comma-separated origins (besides NEXT_PUBLIC_SERVER_URL) allowed to
# frame a customer site, e.g. a headless builder's own dashboard showing a live
# preview (the cafe-restaurant-pos POS's /dashboard/website). Baked in at build
# time; empty (the default) means only the admin origin may frame a site.
# SITE_PREVIEW_ORIGINS=https://pos.example.com

# Media storage — ArvanCloud Object Storage, configured by a superadmin.
#
# The connection is NOT configured here. A platform admin creates it in the admin UI under
# «زیرساخت → اتصالات ذخیره‌سازی» (endpoint, bucket, region, access key, and a secret key
# that is AES-256-GCM encrypted at rest). Every site's media writes there transparently; a
# tenant needs no configuration. With no enabled connection, uploads stay on local disk
# (the development default).
#
# Optional: a dedicated key that seals the stored secret key. When omitted, PAYLOAD_SECRET
# is used. Rotating either requires re-entering the secret key in the admin UI.
# OBJECT_STORAGE_KEY=

# Runs the jobs queue (scheduled publish) inside this process. Unset means
# "production only"; must be false if the web service ever runs more than one
# replica, or every scheduled publish runs once per replica.
# JOBS_AUTORUN=false

# Email — order receipts (src/lib/order-email.ts) and invite emails.
# With no SMTP configured the adapter logs JSON (Payload's previous default, now explicit).
# Set SMTP_* together for real delivery.
# EMAIL_FROM=noreply@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user
# SMTP_PASS=pass
# SMTP_SECURE=false

# Wave 7 — the HTTP payment gateway adapter (store > "درگاه HTTP"). All three are
# required before that provider can be used; a site left on "کارت به کارت" needs none
# of them. Order receipts are signed with PAYLOAD_SECRET, so rotating it invalidates
# every confirmation link already in a buyer's inbox.
# PAYMENT_HTTP_CREATE_URL=https://psp.example/api/invoices
# PAYMENT_HTTP_VERIFY_URL=https://psp.example/api/invoices/verify
# PAYMENT_HTTP_TOKEN=long-random-gateway-credential

# Wave 10 — Iranian payment gateways (ZarinPal, Digipay, Snapp!Pay, Torob Pay).
#
# The module needs no environment variable to work: a tenant's credentials live in its
# `payment-gateways` row, encrypted, and are entered by a platform admin in the CMS. What
# is here is the key that seals them and the network policy around calling out to a PSP.
# See docs/payment-gateways.md.

# The key merchant credentials are sealed with (AES-256-GCM). Derived from PAYLOAD_SECRET
# when unset, so a fresh deployment works with nothing configured here.
#
# Set it explicitly for one reason: rotating it re-encrypts credentials without logging
# every editor out, whereas rotating PAYLOAD_SECRET — which also signs sessions, order
# receipts and preview links — is a much bigger deal than re-entering four merchant
# accounts. ROTATING EITHER ONE INVALIDATES EVERY STORED CREDENTIAL: there is no
# re-encryption job, a platform admin re-enters them, and a row whose secrets no longer
# decrypt is refused with a Persian message rather than failing at the PSP.
# PAYMENT_GATEWAYS_KEY=

# Built-in IRPower / ResellerArea domain reseller. The platform API key itself is entered
# only by a platform admin in «زیرساخت → نمایندگی دامنه», encrypted in the database; do
# not put it in this file. This optional dedicated key seals that stored credential with
# AES-256-GCM. When omitted PAYLOAD_SECRET is used. Rotating either requires re-entering
# the registrar API key. See docs/domain-reseller.md.
# DOMAIN_RESELLER_KEY=

# Milliseconds before the server abandons one ResellerArea API call (1000–60000; default
# 10000). The provider endpoint is configured by the platform admin and must be HTTPS on
# resellerarea.net or irpower.com.
# DOMAIN_RESELLER_TIMEOUT_MS=10000

# Milliseconds before a call to a PSP is abandoned. A buyer is waiting on the checkout, so
# the default is short; raise it only for a provider whose sandbox is genuinely slow.
# PAYMENT_GATEWAY_TIMEOUT_MS=10000

# Comma-separated extra host suffixes a gateway may be called on, on top of the per-provider
# allowlist in src/payments/gateways/registry.ts. For a PSP that moves domain, or a
# per-merchant host Snapp!Pay issued, without a deploy. Suffix-matched, never substring:
# adding `zarinpal.com` does not allow `zarinpal.com.attacker.tld`.
# PAYMENT_GATEWAY_EXTRA_HOSTS=

# Allow http:// (not just https://) to a gateway. Off by default and it should stay that
# way: http sends a merchant's client_secret in cleartext. Only for a staging PSP behind a
# VPN or a local mock in a test.
# PAYMENT_GATEWAY_ALLOW_INSECURE=false

# How long a checkout callback signature stays valid. The deadline is inside the signed
# token, so it cannot be moved by whoever holds the URL. The default is generous because an
# instalment flow can send a buyer through identity verification before it redirects back,
# and being generous is cheap here: a replayed callback cannot move money, it only re-asks
# the PSP a question that has already been answered.
# PAYMENT_GATEWAY_STATE_TTL_MS=1800000

# Skip the DNS check that refuses a gateway host resolving to a private or link-local
# address (169.254.169.254 and friends). For a test pointed at a local mock — never in
# production, where it turns a mistyped base URL into a request to this server's own
# network.
# PAYMENT_GATEWAY_SKIP_DNS=false
